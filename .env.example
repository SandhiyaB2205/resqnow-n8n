# ---- Automation engine (n8n) — SERVER-SIDE ONLY ----
# Your n8n Production Webhook URL. The browser never sees this value: the app
# gateway (/api/n8n/webhook) forwards events upstream with retry.
# Example: https://rakesh00.app.n8n.cloud/webhook/resqnow
N8N_FORWARD_URL=

# (Do NOT use NEXT_PUBLIC_* for webhook URLs — that would leak them to the client.)

# ---- Database (better-auth + Drizzle, used when running real auth) ----
DATABASE_URL=

# ---- Imagery (optional overrides) ----
# NEXT_PUBLIC_HERO_IMAGE_URL=
# NEXT_PUBLIC_WARD_IMAGE_URL=
